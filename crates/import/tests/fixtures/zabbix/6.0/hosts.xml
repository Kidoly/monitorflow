<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>6.0</version>
    <date>2026-11-17T01:45:00Z</date>
    <groups>
        <group>
            <uuid>c9d5fc57550a4c3eaf557719c625d37e</uuid>
            <name>Databases</name>
        </group>
        <group>
            <uuid>dc579cd7a1a34222933f24f52a68bcd8</uuid>
            <name>Linux servers</name>
        </group>
        <group>
            <uuid>4bcc8bff3cb3437292f23e164fee8e47</uuid>
            <name>Web</name>
        </group>
    </groups>
    <hosts>
        <host>
            <host>db-01</host>
            <name>Database 01</name>
            <templates>
                <template>
                    <name>Linux by Zabbix agent</name>
                </template>
            </templates>
            <groups>
                <group>
                    <name>Databases</name>
                </group>
                <group>
                    <name>Linux servers</name>
                </group>
            </groups>
            <interfaces>
                <interface>
                    <useip>NO</useip>
                    <ip/>
                    <dns>mf-import-zbx-db-01</dns>
                    <interface_ref>if1</interface_ref>
                </interface>
            </interfaces>
            <items>
                <item>
                    <name>Backup age</name>
                    <key>backup.age[pg]</key>
                    <delay>1h</delay>
                    <interface_ref>if1</interface_ref>
                    <triggers>
                        <trigger>
                            <expression>last(/db-01/backup.age[pg])&gt;1d</expression>
                            <name>Backup is old</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>Syslog errors</name>
                    <type>ZABBIX_ACTIVE</type>
                    <key>log[/var/log/syslog,error]</key>
                    <trends>0</trends>
                    <value_type>LOG</value_type>
                    <triggers>
                        <trigger>
                            <expression>find(/db-01/log[/var/log/syslog,error],,&quot;regexp&quot;,&quot;error&quot;)=1</expression>
                            <name>Errors in syslog</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>PostgreSQL port</name>
                    <key>net.tcp.port[,5432]</key>
                    <delay>30s</delay>
                    <interface_ref>if1</interface_ref>
                    <triggers>
                        <trigger>
                            <expression>max(/db-01/net.tcp.port[,5432],3m)=0</expression>
                            <name>PostgreSQL port 5432 is down</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NTP answers</name>
                    <type>SIMPLE</type>
                    <key>net.udp.service[ntp]</key>
                    <delay>5m</delay>
                    <interface_ref>if1</interface_ref>
                </item>
                <item>
                    <name>PostgreSQL processes</name>
                    <key>proc.num[postgres]</key>
                    <interface_ref>if1</interface_ref>
                    <triggers>
                        <trigger>
                            <expression>last(/db-01/proc.num[postgres])&lt;1</expression>
                            <name>No PostgreSQL process</name>
                            <priority>DISASTER</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>PostgreSQL service</name>
                    <key>systemd.unit.info[postgresql.service]</key>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <interface_ref>if1</interface_ref>
                    <triggers>
                        <trigger>
                            <expression>last(/db-01/systemd.unit.info[postgresql.service])&lt;&gt;&quot;active&quot;</expression>
                            <name>PostgreSQL service is not running</name>
                            <priority>AVERAGE</priority>
                        </trigger>
                    </triggers>
                </item>
            </items>
            <macros>
                <macro>
                    <macro>{$MEMORY.UTIL.MAX}</macro>
                    <value>95</value>
                </macro>
                <macro>
                    <macro>{$VFS.FS.PUSED.MAX.CRIT:&quot;/var/lib/postgresql&quot;}</macro>
                    <value>95</value>
                </macro>
            </macros>
            <inventory>
                <os>Linux (Ubuntu 24.04 LTS)</os>
            </inventory>
        </host>
        <host>
            <host>web-01</host>
            <name>Web server 01</name>
            <templates>
                <template>
                    <name>Linux by Zabbix agent</name>
                </template>
                <template>
                    <name>Nginx by Zabbix agent</name>
                </template>
            </templates>
            <groups>
                <group>
                    <name>Linux servers</name>
                </group>
                <group>
                    <name>Web</name>
                </group>
            </groups>
            <interfaces>
                <interface>
                    <useip>NO</useip>
                    <ip/>
                    <dns>mf-import-zbx-web-01</dns>
                    <interface_ref>if1</interface_ref>
                </interface>
            </interfaces>
            <items>
                <item>
                    <name>SSH answers</name>
                    <key>net.tcp.service[ssh]</key>
                    <interface_ref>if1</interface_ref>
                    <triggers>
                        <trigger>
                            <expression>last(/web-01/net.tcp.service[ssh])=0</expression>
                            <name>SSH is down</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>Root space used</name>
                    <key>vfs.fs.size[/,pused]</key>
                    <value_type>FLOAT</value_type>
                    <interface_ref>if1</interface_ref>
                    <triggers>
                        <trigger>
                            <expression>last(/web-01/vfs.fs.size[/,pused])&gt;85</expression>
                            <name>Root file system is filling up</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
            </items>
            <httptests>
                <httptest>
                    <name>Shop home</name>
                    <delay>2m</delay>
                    <steps>
                        <step>
                            <name>Home</name>
                            <url>http://127.0.0.1/</url>
                            <status_codes>200</status_codes>
                        </step>
                        <step>
                            <name>Status</name>
                            <url>http://127.0.0.1/basic_status</url>
                            <status_codes>200</status_codes>
                        </step>
                    </steps>
                </httptest>
            </httptests>
            <macros>
                <macro>
                    <macro>{$CPU.UTIL.CRIT}</macro>
                    <value>80</value>
                    <description>Busier than the default</description>
                </macro>
                <macro>
                    <macro>{$NGINX.STUB_STATUS.PATH}</macro>
                    <value>basic_status</value>
                </macro>
            </macros>
            <inventory>
                <os>Linux (Ubuntu 24.04 LTS)</os>
            </inventory>
        </host>
    </hosts>
    <triggers>
        <trigger>
            <expression>min(/db-01/system.cpu.util,10m)&gt;{$DB.CPU.HIGH}</expression>
            <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
            <recovery_expression>max(/db-01/system.cpu.util,5m)&lt;70</recovery_expression>
            <name>Database CPU is high</name>
            <priority>DISASTER</priority>
        </trigger>
        <trigger>
            <expression>last(/web-01/web.test.fail[Shop home])&lt;&gt;0</expression>
            <name>Shop home page fails</name>
            <priority>HIGH</priority>
        </trigger>
    </triggers>
</zabbix_export>

