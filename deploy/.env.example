# Settings of deploy/docker-compose.yml. Copy to deploy/.env, fill in and
# keep private (chmod 600). See docs/deploy-server.md.

# Name or IP address of the web interface.
DOMAIN=monitor.example.com

# Its certificate: acme for a name that resolves publicly, with ports 80 and
# 443 open to the internet, else internal, Caddy's own CA, which browsers
# trust from http://DOMAIN/trust/ (ADR-0068). The installer chooses this.
WEB_CERTIFICATE=acme

# Names and IP addresses agents and relays reach the server at, comma
# separated. The server's certificate is issued for them.
SERVER_NAMES=monitor.example.com

# PostgreSQL passwords. They go in connection URLs, so keep them URL-safe:
#   openssl rand -hex 24
# POSTGRES_PASSWORD is the role that owns the schema, used for migrations,
# backups and restores; POSTGRES_APP_PASSWORD the role the server runs on,
# which is created and follows this value at every start (ADR-0109).
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# Published ports, with their defaults. The install commands of new tokens
# name GRPC_PORT and ENROLL_PORT.
# HTTPS_PORT=443
# HTTP_PORT=80
# GRPC_PORT=7443
# ENROLL_PORT=7445
# MIRROR_PORT=7480

# Administration > Settings changes the next four without touching this
# file; set here, a value wins and the page shows it as locked (ADR-0069).
# METRICS_RETENTION=90d
# LOGS_RETENTION=30d
# Seconds: a session's lifetime, and how long it survives without a request.
# SESSION_LIFETIME=43200
# SESSION_IDLE_TIMEOUT=1800

# https URL of a copy of the agent release files, for the install commands
# of the web interface (the `custom` source); the latest GitHub release by
# default.
# AGENT_DOWNLOAD_URL=https://files.example.com/monitorflow/0.2.0

# Default source of those commands: github, central (this server, after
# `agent-release import`) or custom (AGENT_DOWNLOAD_URL). Unset, global
# administrators choose it in the web interface (ADR-0054).
# AGENT_INSTALL_SOURCE=central

# Where agents and relays reach the package mirrors, also in Settings;
# http://DOMAIN:MIRROR_PORT by default.
# MIRROR_PUBLIC_URL=http://mirror.example.net:7480

# Server updates (ADR-0056, docs/deploy-server.md). The updater pins the
# images of the installed release here: SERVER_IMAGE, WEB_IMAGE,
# UPDATER_IMAGE and MIRROR_IMAGE. Unset, the images are built locally. It
# also keeps Settings' retention here, as UI_METRICS_RETENTION and
# UI_LOGS_RETENTION.
# Where releases come from, http or https; AGENT_DOWNLOAD_URL's by default.
# RELEASE_URL=https://files.example.com/monitorflow/0.2.0
# Host directory for the daily backups (ADR-0058), which hold the CA
# keys; the `backups` volume by default. The updater makes it root:root,
# mode 0700, and its files root's, so the page cannot download them: copy
# them from here. Keep it on a local disk that root owns.
# BACKUP_DIR=/srv/monitorflow/backups
# Docker socket, for rootless Docker.
# DOCKER_SOCKET=/run/user/1000/docker.sock

# Several central servers, Enterprise edition (ADR-0100). Set by the
# installer: SHARE_ADDRESS on the first central server, by --add-server,
# publishes its database and stores there for the added ones; JOINED,
# INSTANCE_NAME and FIRST_ADDRESS on an added one, by --join, which runs
# deploy/docker-compose.joined.yml instead of this file.
# SHARE_ADDRESS=10.0.0.10
