# Settings of deploy/docker-compose.yml. Copy to deploy/.env, fill in and
# keep private (chmod 600). See docs/deploy-server.md.

# Name or IP address of the web interface. A public DNS name gets a
# certificate by ACME; an IP address or internal name gets one from Caddy's
# own CA.
DOMAIN=monitor.example.com

# Names and IP addresses agents and relays reach the server at, comma
# separated. The server's certificate is issued for them.
SERVER_NAMES=monitor.example.com

# PostgreSQL password. It goes in a connection URL, so keep it URL-safe:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Published ports and retention, with their defaults. The install commands
# of new tokens name GRPC_PORT and ENROLL_PORT.
# HTTPS_PORT=443
# HTTP_PORT=80
# GRPC_PORT=7443
# ENROLL_PORT=7445
# MIRROR_PORT=7480
# METRICS_RETENTION=90d
# LOGS_RETENTION=30d

# https URL of a copy of the agent release files, for the install commands
# of the web interface (the `custom` source); the latest GitHub release by
# default.
# AGENT_DOWNLOAD_URL=https://files.example.com/monitorflow/0.2.0

# Default source of those commands: github, central (this server, after
# `agent-release import`) or custom (AGENT_DOWNLOAD_URL). Unset, global
# administrators choose it in the web interface (ADR-0054).
# AGENT_INSTALL_SOURCE=central

# Where agents and relays reach the package mirrors; http://DOMAIN:MIRROR_PORT
# by default.
# MIRROR_PUBLIC_URL=http://mirror.example.net:7480

# Server updates (ADR-0056, docs/deploy-server.md). The updater pins the
# images of the installed release here: SERVER_IMAGE, WEB_IMAGE,
# UPDATER_IMAGE and MIRROR_IMAGE. Unset, the images are built locally.
# Where releases come from, http or https; AGENT_DOWNLOAD_URL's by default.
# RELEASE_URL=https://files.example.com/monitorflow/0.2.0
# Host directory for the daily backups (ADR-0058), which hold the CA
# keys; the `backups` volume by default.
# BACKUP_DIR=/srv/monitorflow/backups
# Docker socket, for rootless Docker.
# DOCKER_SOCKET=/run/user/1000/docker.sock
