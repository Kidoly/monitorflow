<?xml version="1.0" encoding="utf-8"?>
<!--
  Extension point of the MSI package (ADR-0050): components of other parts
  of the agent, installed with the agent feature. The update service of
  ADR-0049 runs the agent's own binary, so its ServiceInstall sits in the
  AgentExe component of Package.wxs, which owns that file (ADR-0053).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="AgentHelpers" />
  </Fragment>
</Wix>
