# MonitorFlow agent: the privileged commands it runs through `sudo -n`
# (ADR-0031, ADR-0032, ADR-0035, ADR-0036, ADR-0053, ADR-0094, ADR-0181,
# ADR-0182, ADR-0190). Install as /etc/sudoers.d/monitorflow-agent, owner
# root, mode 0440, and check with `visudo -cf`. See docs/deploy-agent.md.
#
# Exact command lines, no wildcards: sudo refuses any other argument.
# Updates of every kind (all, security only, named packages) go through
# the agent's own helper, which reads the packages to update on stdin and
# checks them before running apt or dnf (ADR-0036).

Cmnd_Alias MONITORFLOW_PACKAGES = /usr/bin/monitorflow-agent packages update
Cmnd_Alias MONITORFLOW_REBOOT = /usr/sbin/shutdown -r +1
Cmnd_Alias MONITORFLOW_SOURCES = \
    /usr/bin/monitorflow-agent sources apply, \
    /usr/bin/monitorflow-agent sources revert
# Self-update: the helper reads a signed release on stdin and installs it
# only if the release key built into it verifies it (ADR-0053), and only
# for a command the central server signed for this server, which it checks
# against its own copy of the certificate authority (ADR-0108).
Cmnd_Alias MONITORFLOW_SELF_UPDATE = /usr/bin/monitorflow-agent self-update
# Local snapshots of the system volumes on LVM or ZFS: the helper reads
# only a snapshot name on stdin and picks the volumes itself (ADR-0094).
Cmnd_Alias MONITORFLOW_SNAPSHOTS = \
    /usr/bin/monitorflow-agent snapshots inspect, \
    /usr/bin/monitorflow-agent snapshots take, \
    /usr/bin/monitorflow-agent snapshots delete
# Major upgrade of the distribution: the helper reads a `major_upgrade`
# command the central server signed on stdin, starts it only if
# `packages.major_upgrades` is set in agent.toml, the server runs the
# release it names and every check passes, then runs it in a transient
# systemd unit (ADR-0182). Never a command line.
Cmnd_Alias MONITORFLOW_MAJOR_UPGRADE = /usr/bin/monitorflow-agent major-upgrade

# AI root actions: the helper reads a `root_action` command the central
# server signed on stdin, runs it only if `commands.root_actions` is set in
# agent.toml, and only one action of its fixed catalog with checked
# parameters (ADR-0181). Never a command line.
Cmnd_Alias MONITORFLOW_ROOT_ACTIONS = /usr/bin/monitorflow-agent root-action

# Remote terminals as the account `remote.terminal_user` names: the helper
# reads a signed remote_session command on stdin, checks it against its
# own copy of the certificate authority, and refuses unless agent.toml
# allows terminals and names that account (ADR-0190).
Cmnd_Alias MONITORFLOW_REMOTE_SHELL = /usr/bin/monitorflow-agent remote-shell

monitorflow ALL=(root) NOPASSWD: MONITORFLOW_PACKAGES, MONITORFLOW_REBOOT, MONITORFLOW_SOURCES, MONITORFLOW_SELF_UPDATE, MONITORFLOW_SNAPSHOTS, MONITORFLOW_MAJOR_UPGRADE, MONITORFLOW_ROOT_ACTIONS, MONITORFLOW_REMOTE_SHELL
