# MonitorFlow agent: the privileged commands it runs through `sudo -n`
# (ADR-0031, ADR-0032, ADR-0035, ADR-0036). Install as
# /etc/sudoers.d/monitorflow-agent, owner root, mode 0440, and check with
# `visudo -cf`. See docs/deploy-agent.md.
#
# Exact command lines, no wildcards: sudo refuses any other argument.
# Updates of every kind (all, security only, named packages) go through
# the agent's own helper, which reads the packages to update on stdin and
# checks them before running apt or dnf (ADR-0036).

Cmnd_Alias MONITORFLOW_PACKAGES = /usr/bin/monitorflow-agent packages update
Cmnd_Alias MONITORFLOW_REBOOT = /usr/sbin/shutdown -r +1
Cmnd_Alias MONITORFLOW_SOURCES = \
    /usr/bin/monitorflow-agent sources apply, \
    /usr/bin/monitorflow-agent sources revert

monitorflow ALL=(root) NOPASSWD: MONITORFLOW_PACKAGES, MONITORFLOW_REBOOT, MONITORFLOW_SOURCES
